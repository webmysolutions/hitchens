# Copy to .env and fill in. Every value can also be set later from the admin panel
# (Settings are stored in the SQLite database and override these defaults).

# Port for the web server
PORT=3000

# Telegram bot token from @BotFather. Leave empty to run in demo mode (no bot).
BOT_TOKEN=

# Public URL where the webapp is hosted (used for the bot's "Play" button), e.g. https://games.example.com
WEBAPP_URL=

# Admin panel password (login: any name + this password). CHANGE IT.
ADMIN_PASSWORD=admin

# Google AdSense client id, e.g. ca-pub-XXXXXXXXXXXXXXXX. Leave empty until you have it.
ADSENSE_CLIENT=

# SQLite database file location
DB_PATH=./data/minigames.db
